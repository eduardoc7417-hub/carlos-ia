#!/bin/sh
# Identidade do sistema. dpkg-divert impede que atualizações do base-files restaurem os originais.
set -e

for f in /usr/lib/os-release /etc/issue /etc/issue.net; do
  dpkg-divert --local --rename --add "$f"
done

cat > /usr/lib/os-release <<'EOF'
PRETTY_NAME="Carlos OS Aurora 0.8"
NAME="Carlos OS Aurora"
VERSION_ID="0.8"
VERSION="0.8"
ID=carlos-os
ID_LIKE=debian
LOGO=carlos-logo
EOF

printf 'Carlos OS Aurora 0.8 \\n \\l\n\n' > /etc/issue
printf 'Carlos OS Aurora 0.8\n' > /etc/issue.net
